# extras.zsh -- the settings from extras.bash that oh-my-zsh does not already cover.
# Sourced from ~/.zshrc by install.sh, after oh-my-zsh.

export EDITOR=vim VISUAL=vim

alias c='clear'
alias sysupdate='sudo apt-get update && sudo apt-get upgrade -y && sudo apt-get autoclean && sudo apt-get autoremove -y'
